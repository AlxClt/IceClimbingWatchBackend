# Environment / secrets files (provided at runtime via env_file or --env-file)
.env*
!.env.example

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
venv/
env/
.venv/

# Local development files
*.log
logs/
*.sqlite
*.db

# OS files
.DS_Store
Thumbs.db

# Editor settings
.vscode/
.idea/

# Docker artifacts
Dockerfile
.dockerignore
docker-compose*.yml

# Tests (not needed at runtime)
tests/
.pytest_cache/
